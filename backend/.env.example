# ---- copy to .env (root, for docker compose) or backend/.env (for local dev) ----
DJANGO_DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sonarhorin.com
CORS_ALLOWED_ORIGINS=http://localhost,https://sonarhorin.com
SITE_URL=https://sonarhorin.com
# set to False only if TLS is terminated somewhere that doesn't send X-Forwarded-Proto
SECURE_SSL_REDIRECT=True

# Claude — powers CV tailoring, interview kits, answer feedback and the streaming coach.
# Without a key every feature still works using the built-in rule engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_RATE=60/hour

POSTGRES_DB=sonarhorin
POSTGRES_USER=sonarhorin
POSTGRES_PASSWORD=

DISCORD_INVITE_URL=https://discord.gg/your-invite-code
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Testing the docker stack on plain http://localhost (no TLS)? uncomment both — never in production:
# SECURE_SSL_REDIRECT=False
# COOKIE_SECURE=False

# ==== Third-party integrations — all optional; see docs/integrations/INTEGRATIONS.md ====
# Google Sign-In (same OAuth client ID as VITE_GOOGLE_CLIENT_ID; comma-separate several)
GOOGLE_CLIENT_ID=

# Phone OTP login. SMS_BACKEND: console (dev only, logs the code) | sslwireless | bulksmsbd | alphasms
SMS_BACKEND=console
SMS_API_KEY=
SMS_SENDER_ID=
# optional: override the provider's default endpoint URL
SMS_API_URL=
SMS_TIMEOUT=10
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_PHONE_RATE=5/hour
OTP_IP_RATE=20/hour
OTP_VERIFY_IP_RATE=30/hour
OTP_ALLOW_SIGNUP=True

# Web push (VAPID). Generate: see INTEGRATIONS.md
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sonarhorin.com
# PUSH_ALLOWED_HOST_SUFFIXES=fcm.googleapis.com,android.googleapis.com,push.services.mozilla.com,notify.windows.com,push.apple.com

# Sentry (backend)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# SSLCommerz payments (premium). Sandbox store: https://developer.sslcommerz.com/registration/
SSLCZ_STORE_ID=
SSLCZ_STORE_PASS=
SSLCZ_SANDBOX=True
# public origin of this API (SSLCommerz posts IPN + browser returns here)
API_PUBLIC_URL=https://api.sonarhorin.com
PREMIUM_MONTHLY_BDT=199
PREMIUM_YEARLY_BDT=1499
