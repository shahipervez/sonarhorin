# ---- copy to .env (root, for docker compose) or backend/.env (for local dev) ----
DJANGO_DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sonarhorin.com
CORS_ALLOWED_ORIGINS=http://localhost,https://sonarhorin.com
SITE_URL=https://sonarhorin.com
# set to False only if TLS is terminated somewhere that doesn't send X-Forwarded-Proto
SECURE_SSL_REDIRECT=True

# Claude — powers CV tailoring, interview kits, answer feedback and the streaming coach.
# Without a key every feature still works using the built-in rule engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_RATE=60/hour

POSTGRES_DB=sonarhorin
POSTGRES_USER=sonarhorin
POSTGRES_PASSWORD=

DISCORD_INVITE_URL=https://discord.gg/your-invite-code
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Testing the docker stack on plain http://localhost (no TLS)? uncomment both — never in production:
# SECURE_SSL_REDIRECT=False
# COOKIE_SECURE=False

# Job scraper: production runs it from GitHub Actions cron (.github/workflows/scrape-jobs.yml).
# The in-process thread is off by default when DEBUG is off or on Vercel; set true to force it on
# (single always-on server only, e.g. one docker container / one Fly machine).
# ENABLE_INPROCESS_SCHEDULER=false
# AUTO_SCRAPE_INTERVAL_MINUTES=60
