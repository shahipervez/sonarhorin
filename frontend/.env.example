# Leave empty in development (Vite proxies /api to Django).
# In production, set to your API origin, e.g. https://api.prothom.com
VITE_API_URL=

# ---- Third-party integrations — all optional (see docs/integrations/INTEGRATIONS.md)
# Google Identity Services "Continue with Google" button (same client ID as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
# Sentry (loaded via dynamic import only when set)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
# Analytics — set ONE of these (PostHog wins if both are set)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
